PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=24h
DB_PATH=./data/rebornmc.db

# ── Pterodactyl (optionnel) ──────────────────────────────────────────────────
# Renseignez ces 3 variables pour récupérer les stats serveur en temps réel
# (statut, RAM, CPU, uptime) depuis votre panel Pterodactyl.
# Clé API : Panel → Compte → API Credentials → Create API Key
# Server ID : l'identifiant court affiché dans l'URL de votre serveur
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_API_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PTERODACTYL_SERVER_ID=xxxxxxxx

# ── Minecraft Server Ping (optionnel) ────────────────────────────────────────
# Renseignez l'adresse de votre serveur pour récupérer le nombre de joueurs
# et la version en temps réel via le protocole Server List Ping.
MC_HOST=play.example.com
MC_PORT=25565
